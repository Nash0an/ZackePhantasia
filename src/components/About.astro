---
import SmartImage from './SmartImage.astro';
import { person } from '../data/profile';
import { getImage, imageSlots } from '../data/images';

const image = await getImage(imageSlots.about);
---

<section id="ueber-mich" class="section section--alt slanted" aria-labelledby="about-title">
  <div class="container about">
    <div class="about__media reveal">
      <SmartImage image={image} sizes="(min-width: 900px) 520px, 92vw" fallbackLabel="Bild folgt" />
    </div>
    <div class="about__text reveal">
      <span class="eyebrow">Über mich</span>
      <h2 id="about-title">{person.intro}</h2>
      {person.bio.map((p) => <p>{p}</p>)}
      {
        person.location && (
          <p class="about__location">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path
                fill="currentColor"
                d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"
              />
            </svg>
            {person.location}
          </p>
        )
      }
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .about {
      grid-template-columns: 0.9fr 1.1fr;
    }
  }
  .about__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    clip-path: polygon(0 0, 100% 0, 92% 100%, 0 100%);
  }
  .about__text h2 {
    font-size: clamp(1.6rem, 1.3rem + 1.3vw, 2.4rem);
    font-weight: 500;
    line-height: 1.15;
    text-transform: none;
  }
  .about__text p {
    color: var(--text-muted);
  }
  .about__location {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 500;
    color: var(--text) !important;
  }
  .about__location svg {
    color: var(--warm);
  }
</style>
