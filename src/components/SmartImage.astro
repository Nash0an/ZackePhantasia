---
import { Picture } from 'astro:assets';
import type { ResolvedImage } from '../data/images';

/**
 * Responsives Bild mit Fokuspunkt. Ist kein (freigegebenes) Bild vorhanden,
 * wird eine neutrale Fläche gezeigt – die Seite bleibt so immer vollständig.
 */
interface Props {
  image?: ResolvedImage;
  sizes: string;
  widths?: number[];
  priority?: boolean;
  class?: string;
  fallbackLabel?: string;
}

const {
  image,
  sizes,
  widths = [400, 640, 960, 1280],
  priority = false,
  class: className,
  fallbackLabel = 'Bild folgt',
} = Astro.props;

const usableWidths = image ? widths.filter((w) => w <= image.src.width) : [];
if (image && usableWidths.length === 0) usableWidths.push(image.src.width);
---

{
  image ? (
    <Picture
      src={image.src}
      alt={image.alt}
      widths={usableWidths}
      sizes={sizes}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      quality={72}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
      class:list={['smart-img', className]}
      style={`object-position: ${image.focus}`}
      pictureAttributes={{ class: 'smart-img__picture' }}
    />
  ) : (
    <div class:list={['smart-img smart-img--fallback', className]} role="img" aria-label={fallbackLabel}>
      <span>{fallbackLabel}</span>
    </div>
  )
}

<style>
  .smart-img__picture {
    display: contents;
  }
  :global(.smart-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .smart-img--fallback {
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 30% 20%, var(--accent-soft), transparent 60%),
      linear-gradient(135deg, var(--bg-alt), var(--accent-soft));
    color: var(--text-muted);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    min-height: 100%;
  }
</style>
