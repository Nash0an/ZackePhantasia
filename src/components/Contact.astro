---
import SmartImage from './SmartImage.astro';
import { person } from '../data/profile';
import { getImage, imageSlots } from '../data/images';

const background = await getImage(imageSlots.contactBackground);
const primary = person.contact[0];
---

<section id="kontakt" class="contact" aria-labelledby="contact-title">
  {
    background && (
      <div class="contact__bg" aria-hidden="true">
        <SmartImage image={background} sizes="100vw" widths={[640, 1024, 1536]} />
      </div>
    )
  }
  <div class:list={['container contact__inner', { 'has-bg': background }]}>
    <span class="eyebrow">Kontakt</span>
    <h2 id="contact-title">Lassen Sie uns sprechen.</h2>
    <p class="contact__lead">
      [PLATZHALTER] Einladung zur Kontaktaufnahme – z. B. für Anfragen, Kooperationen oder ein erstes
      Kennenlerngespräch.
    </p>
    {
      primary && (
        <a class="btn btn--primary contact__cta" href={primary.href}>
          {primary.label}: {primary.value}
        </a>
      )
    }
    {
      person.contact.length > 1 && (
        <ul class="contact__more">
          {person.contact.slice(1).map((c) => (
            <li>
              <a href={c.href}>
                {c.label}: {c.value}
              </a>
            </li>
          ))}
        </ul>
      )
    }
    {
      person.social.length > 0 && (
        <ul class="contact__social" aria-label="Profile">
          {person.social.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer me">
                {s.label}
                <span class="visually-hidden"> (öffnet in neuem Tab)</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .contact {
    position: relative;
    isolation: isolate;
    padding-block: var(--section-space);
    background: #0b0d10;
    color: #fff;
    overflow: hidden;
    clip-path: polygon(0 var(--slant), 100% 0, 100% 100%, 0 100%);
    padding-top: calc(var(--section-space) + var(--slant));
  }
  .contact__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .contact::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(110deg, rgb(8 10 13 / 0.92) 0%, rgb(8 10 13 / 0.65) 55%, rgb(255 90 31 / 0.35) 100%);
  }
  .contact__inner {
    max-width: var(--max);
  }
  .contact .eyebrow {
    color: #ff7d4a;
  }
  .contact h2 {
    max-width: 16ch;
    font-size: clamp(2rem, 1.5rem + 2.6vw, 3.4rem);
  }
  .contact__lead {
    max-width: 36rem;
    color: rgb(255 255 255 / 0.85);
    font-size: 1.1rem;
    margin-bottom: 2rem;
  }
  .contact__cta {
    background: #ff5a1f;
    color: #0b0d10;
    text-transform: none;
    letter-spacing: 0.02em;
    word-break: break-all;
  }
  .contact__cta:hover {
    background: #fff;
    color: #0b0d10;
  }
  .contact__more,
  .contact__social {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  .contact a:not(.btn) {
    color: #fff;
  }
  .contact :focus-visible {
    outline-color: #fbbf24;
  }
</style>
